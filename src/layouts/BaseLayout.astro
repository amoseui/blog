---
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";

import "@/assets/scss/main.scss";

import Meta from "@/components/Meta/Meta.astro";
import styles from "@/components/Layout/Layout.module.scss";
import { site } from "@/lib/site";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = site.subtitle, image } = Astro.props;

// Favicons are generated from content/photo.jpg at build time (see
// scripts/generate-icons.mjs). The cache-buster is derived from the source
// image content so swapping the photo invalidates cached icons automatically.
const ICON_SIZES = [48, 72, 96, 144, 192, 256, 384, 512];
const iconVersion = createHash("md5")
  .update(readFileSync("content/photo.jpg"))
  .digest("hex");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Meta title={title} description={description} image={image} />
    <link
      rel="icon"
      href={`/favicon-32x32.png?v=${iconVersion}`}
      type="image/png"
    />
    {
      ICON_SIZES.map((size) => (
        <link
          rel="apple-touch-icon"
          sizes={`${size}x${size}`}
          href={`/icons/icon-${size}x${size}.png?v=${iconVersion}`}
        />
      ))
    }
    <script is:inline>
      (() => {
        let mode = "light";
        try {
          const stored = JSON.parse(localStorage.getItem("diesel:theme-atom"));
          if (stored && (stored.mode === "dark" || stored.mode === "light"))
            mode = stored.mode;
          else if (matchMedia("(prefers-color-scheme: dark)").matches)
            mode = "dark";
        } catch (_) {
          if (matchMedia("(prefers-color-scheme: dark)").matches) mode = "dark";
        }
        document.documentElement.className = mode;
      })();
    </script>
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAnalyticsId}`}
    ></script>
    <script is:inline define:vars={{ gaId: site.googleAnalyticsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", gaId);
    </script>
  </head>
  <body>
    <div class={styles.layout}><slot /></div>
  </body>
</html>
