---
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";

import "@/assets/scss/main.scss";

import Meta from "@/components/Meta/Meta.astro";
import Copyright from "@/components/Sidebar/Copyright/Copyright.astro";
import styles from "@/components/Layout/Layout.module.scss";
import { FAVICON_MASK, ICON_SOURCE } from "@/lib/icons";
import { site } from "@/lib/site";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  showCopyright?: boolean;
}

const {
  title,
  description = site.subtitle,
  image,
  type,
  showCopyright = true,
} = Astro.props;

// Github pages serves directory output at the trailing-slash url (bare form
// 301s), so the slash form is the canonical one search engines should index.
const canonicalPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(canonicalPath, site.url).toString();

// Favicons are rendered from content/photo.jpg by the file endpoints in
// src/pages (favicon-32x32.png.ts, apple-touch-icon.png.ts). The cache-buster
// includes the source image and favicon mask so changing the photo or shape
// invalidates cached icons automatically.
const iconVersion = createHash("md5")
  .update(readFileSync(ICON_SOURCE))
  .update(FAVICON_MASK)
  .digest("hex");

// Keep the head loader and literal config ID for Search Console verification.
// Delay config work until after rendering, with an early-exit fallback.
const googleAnalyticsScript = `
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      (() => {
        const startedAt = new Date();
        let initialized = false;
        const initialize = () => {
          if (initialized) return;
          initialized = true;
          gtag("js", startedAt);
          gtag("config", ${JSON.stringify(site.googleAnalyticsId).replaceAll("<", "\\u003c")});
          window.removeEventListener("pagehide", initialize);
          document.removeEventListener("visibilitychange", onVisibilityChange);
        };
        const onVisibilityChange = () => {
          if (document.visibilityState === "hidden") initialize();
        };
        const schedule = () => {
          requestAnimationFrame(() => setTimeout(initialize, 0));
        };
        window.addEventListener("pagehide", initialize, { once: true });
        document.addEventListener("visibilitychange", onVisibilityChange);
        if (document.visibilityState === "hidden") initialize();
        else if (document.readyState === "complete") schedule();
        else window.addEventListener("load", schedule, { once: true });
      })();
    `;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Meta title={title} description={description} image={image} type={type} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="icon"
      href={`/favicon-32x32.png?v=${iconVersion}`}
      type="image/png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`/apple-touch-icon.png?v=${iconVersion}`}
    />
    <script is:inline>
      (() => {
        let mode = "light";
        try {
          const stored = JSON.parse(localStorage.getItem("diesel:theme-atom"));
          if (stored && (stored.mode === "dark" || stored.mode === "light"))
            mode = stored.mode;
          else if (matchMedia("(prefers-color-scheme: dark)").matches)
            mode = "dark";
        } catch (_) {
          if (matchMedia("(prefers-color-scheme: dark)").matches) mode = "dark";
        }
        document.documentElement.className = mode;
      })();
    </script>
    <script
      is:inline
      async
      fetchpriority="low"
      src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAnalyticsId}`}
    ></script>
    <script is:inline set:html={googleAnalyticsScript} />
  </head>
  <body>
    <div class={styles.layout}><slot /></div>
    {
      showCopyright && (
        <Copyright copyright={site.copyright} placement="footer" />
      )
    }
  </body>
</html>
