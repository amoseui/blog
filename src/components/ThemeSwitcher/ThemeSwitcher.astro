---
import styles from "./ThemeSwitcher.module.scss";
---

<div class={styles.themeSwitcher} data-theme-switcher>
  <button class={styles.button}>
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <title>light</title>
      <path
        pathLength="1"
        class={styles.moon}
        d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      <circle pathLength="1" class={styles.sun} cx="12" cy="12" r="5"></circle>
      <line pathLength="1" class={styles.sun} x1="12" y1="1" x2="12" y2="3"
      ></line>
      <line pathLength="1" class={styles.sun} x1="12" y1="21" x2="12" y2="23"
      ></line>
      <line
        pathLength="1"
        class={styles.sun}
        x1="4.22"
        y1="4.22"
        x2="5.64"
        y2="5.64"></line>
      <line
        pathLength="1"
        class={styles.sun}
        x1="18.36"
        y1="18.36"
        x2="19.78"
        y2="19.78"></line>
      <line pathLength="1" class={styles.sun} x1="1" y1="12" x2="3" y2="12"
      ></line>
      <line pathLength="1" class={styles.sun} x1="21" y1="12" x2="23" y2="12"
      ></line>
      <line
        pathLength="1"
        class={styles.sun}
        x1="4.22"
        y1="19.78"
        x2="5.64"
        y2="18.36"></line>
      <line
        pathLength="1"
        class={styles.sun}
        x1="18.36"
        y1="5.64"
        x2="19.78"
        y2="4.22"></line>
    </svg>
  </button>
</div>

<script>
  import styles from "./ThemeSwitcher.module.scss";

  const switcher = document.querySelector("[data-theme-switcher]");
  const title = switcher?.querySelector("svg title");

  // Keep the switcher icon (sun/moon) in sync with the documentElement theme
  const syncIcon = () => {
    const mode = document.documentElement.className === "dark" ? "dark" : "light";
    switcher?.classList.toggle(styles.dark, mode === "dark");
    if (title) title.textContent = mode;
  };

  syncIcon();

  switcher?.addEventListener("click", () => {
    const next = document.documentElement.className === "dark" ? "light" : "dark";
    document.documentElement.className = next;
    localStorage.setItem("diesel:theme-atom", JSON.stringify({ mode: next }));
    syncIcon();
  });
</script>
