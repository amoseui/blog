---
import { byTag } from "@/lib/posts";
import type { PaginationState } from "@/lib/pagination";
import { site } from "@/lib/site";
import Pagination from "@/components/Pagination/Pagination.astro";

import Author from "./Author/Author.astro";
import Contacts from "./Contacts/Contacts.astro";
import Copyright from "./Copyright/Copyright.astro";
import TagNavigation from "./TagNavigation/TagNavigation.astro";

import styles from "./Sidebar.module.scss";

interface Props {
  isIndex?: boolean;
  pagination?: PaginationState;
}

const { isIndex, pagination } = Astro.props;
const { author, copyright } = site;
const tags = [...(await byTag())]
  .sort(
    ([tagA, postsA], [tagB, postsB]) =>
      postsB.length - postsA.length || tagA.localeCompare(tagB),
  )
  .map(([tag]) => tag);
---

<div class={styles.sidebar}>
  <div class={styles.inner}>
    <Author author={author} isIndex={isIndex} />
    <Contacts contacts={author.contacts} />
    <TagNavigation tags={tags} />
    {pagination && <Pagination {...pagination} placement="sidebar" />}
    <Copyright copyright={copyright} placement="sidebar" />
  </div>
</div>
