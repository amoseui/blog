---
import { href, tagUrl } from "@/lib/urls";

import styles from "./TagNavigation.module.scss";

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
const currentPath = href(Astro.url.pathname);
const isCurrentTag = (tag: string) => currentPath.startsWith(href(tagUrl(tag)));
const isAll = currentPath === "/" || /^\/page\/\d+\/$/.test(currentPath);
---

<nav class={styles.navigation} aria-label="Topics">
  <ul class={styles.list}>
    <li class={styles.item}>
      <a class={styles.chip} href="/" aria-current={isAll ? "page" : undefined}>
        All
      </a>
    </li>
    {
      tags.map((tag) => (
        <li class={styles.item}>
          <a
            class={styles.chip}
            href={href(tagUrl(tag))}
            aria-current={isCurrentTag(tag) ? "page" : undefined}
          >
            {tag}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
