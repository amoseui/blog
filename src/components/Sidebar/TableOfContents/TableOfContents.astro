---
import type { MarkdownHeading } from "astro";

import styles from "./TableOfContents.module.scss";

interface Props {
  headings: MarkdownHeading[];
}

const headings = Astro.props.headings.filter(
  ({ depth }) => depth === 2 || depth === 3,
);
---

{
  headings.length > 0 && (
    <div class={styles.outline} data-table-of-contents>
      <script is:inline>
        /* Set initial visibility before parsing the outline. */
        document.currentScript?.parentElement?.setAttribute("data-enhanced",
        "");
      </script>
      <h2 class={styles.title}>
        <span data-contents-title>Contents</span>
        <button
          class={styles.toggle}
          type="button"
          aria-label="Contents"
          aria-expanded="false"
          aria-controls="post-contents"
          data-contents-toggle
        >
          Contents
        </button>
      </h2>
      <nav class={styles.navigation} id="post-contents" aria-label="목차">
        <ol class={styles.list}>
          {headings.map(({ depth, slug, text }) => (
            <li class:list={[styles.item, depth === 3 && styles.nested]}>
              <a class={styles.link} href={`#${encodeURIComponent(slug)}`}>
                {text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  )
}

<script>
  const outline = document.querySelector<HTMLElement>(
    "[data-table-of-contents]",
  );
  const toggle = outline?.querySelector<HTMLButtonElement>(
    "[data-contents-toggle]",
  );
  if (toggle) {
    const desktop = matchMedia("(min-width: 960px)");
    desktop.addEventListener("change", () => {
      toggle.setAttribute("aria-expanded", "false");
    });
    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
    });
  }
</script>
