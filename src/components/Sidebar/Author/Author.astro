---
import { Image } from "astro:assets";

import photo from "../../../../content/photo.jpg";
import ThemeSwitcher from "@/components/ThemeSwitcher/ThemeSwitcher.astro";

import styles from "./Author.module.scss";

interface Props {
  author: {
    name: string;
    bio: string;
  };
  isIndex?: boolean;
}

const { author, isIndex } = Astro.props;
---

<div class={styles.author}>
  <a href="/" class={styles.photoLink}>
    <Image
      src={photo}
      alt={author.name}
      class={styles.photo}
      width={168}
      height={168}
      widths={[168, 224]}
      sizes="56px"
      layout="fixed"
      format="webp"
      quality={90}
      loading="eager"
    />
  </a>

  <div class={styles.details}>
    <div class={styles.titleContainer}>
      {
        isIndex ? (
          <h1 class={styles.title}>
            <a class={styles.link} href="/">
              {author.name}
            </a>
          </h1>
        ) : (
          <h2 class={styles.title}>
            <a class={styles.link} href="/">
              {author.name}
            </a>
          </h2>
        )
      }
      <ThemeSwitcher />
    </div>
    <p class={styles.subtitle}>{author.bio}</p>
  </div>
</div>
