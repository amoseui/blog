---
interface Props {
  description: string;
  image?: string;
  title: string;
  type?: "website" | "article";
}

const naverMeta = "b14b409f559df7b1c4219c72067097d7cd45ce9c";
const { description, title, image, type = "website" } = Astro.props;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="naver-site-verification" content={naverMeta} />
<meta name="google-adsense-account" content="ca-pub-4762858711025506" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta property="og:title" content={title} />
<meta property="og:type" content={type} />
<meta property="og:description" content={description} />

{
  image ? (
    <>
      <meta name="image" content={image} />
      <meta property="og:image" content={image} />
      <meta name="twitter:image" content={image} />
    </>
  ) : null
}
