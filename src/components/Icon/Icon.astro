---
import { ICONS } from "@/constants";

import styles from "./Icon.module.scss";

interface Props {
  name: keyof typeof ICONS;
  icon: {
    viewBox?: string;
    path?: string;
    attribution?: string;
  };
}

const { name, icon } = Astro.props;
const title =
  name === "x" ? "X" : name === "speakerdeck" ? "Speaker Deck" : name;
const smaller = ["rss", "email", "linkedin", "medium", "x", "youtube"].includes(
  name,
);
---

<svg
  class:list={[
    styles.icon,
    smaller && styles.smaller,
    name === "github" && styles.larger,
  ]}
  viewBox={icon.viewBox}
>
  <title>{title}</title>
  {icon.attribution && <metadata>{icon.attribution}</metadata>}
  <path d={icon.path}></path>
</svg>
