{
  "name": "blog",
  "version": "4.0.1",
  "private": true,
  "description": "Everything in its Right Place",
  "keywords": [
    "astro",
    "blog"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/amoseui/blog.git"
  },
  "license": "MIT",
  "author": "Amos Lim <amoseui@gmail.com>",
  "scripts": {
    "build": "astro build",
    "format": "npm run format:ts && npm run format:scss",
    "format:scss": "stylelint \"src/**/*.scss\" --fix",
    "format:ts": "eslint \"src\" --fix && prettier --write .",
    "lint": "npm run lint:ts && npm run lint:scss",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:ts": "eslint \"src\" && prettier --check .",
    "serve": "astro preview",
    "start": "astro dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "prebuild": "npm run icons",
    "prestart": "npm run icons"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^5.48.1",
    "@typescript-eslint/parser": "^5.48.1",
    "autoprefixer": "^10.4.13",
    "eslint": "^8.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "glob": "^13.0.6",
    "lost": "9.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "sass": "^1.57.1",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-order": "^8.1.1",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/prism": "^4.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6"
  }
}
